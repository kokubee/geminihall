{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geminihall",
  "account_id": "95d6955c074ae209d4b690da717bb7b1",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "geminihall.cc", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/sitemap.xml", "/entries/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geminihall",
      "database_id": "a303f187-338a-4501-b87f-492b534a8e27",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1501",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SUBMIT_TOKEN_LIMITER",
      "namespace_id": "1502",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "private-tools.cloudflareaccess.com",
    "ACCESS_AUD": "ca35e11065883a7e0e5edfe590e2640492ca6bf0e97b2b751d8cdadbb23be96d",
    "CONSENT_VERSION": "2026-10-15"
  }
}
